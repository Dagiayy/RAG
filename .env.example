# --- App ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL ---
# NOTE: host port 5433 (not the default 5432) because another project's
# Postgres container already occupies 5432 on this machine. The container's
# internal port is still 5432; only the host-side mapping differs.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=enterprise_rag
POSTGRES_USER=enterprise_rag
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://enterprise_rag:change_me@localhost:5433/enterprise_rag

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_chunks

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# --- LLM (OpenAI-compatible API — Ollama's /v1 endpoint by default; swap
# these three to point at any other OpenAI-compatible provider) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:7b-instruct-q4_K_M
OPENAI_JUDGE_MODEL=qwen2.5:7b-instruct-q4_K_M
# Native Ollama API (not OpenAI-compatible), used only by the /ready probe.
OLLAMA_NATIVE_BASE_URL=http://localhost:11434

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=2048

# --- Reranking ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32

# --- Retrieval ---
RETRIEVAL_TOP_K_VECTOR=50
RETRIEVAL_TOP_K_BM25=50
RETRIEVAL_RERANK_CANDIDATES=30
RETRIEVAL_FINAL_EVIDENCE_COUNT=8
RETRIEVAL_MIN_EVIDENCE_SCORE=0.3
RETRIEVAL_RRF_K=60

# --- Security ---
MAX_UPLOAD_MB=50

# --- Observability ---
REQUEST_ID_HEADER=X-Request-ID
